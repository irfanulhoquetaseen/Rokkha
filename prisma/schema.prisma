// JibonSetu data model.
// P0 contains only the minimal model used by the health check; the real schema arrives in P1.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// One row per server boot; lets /api/health prove a real read/write round-trip exists.
model SystemHeartbeat {
  id        Int      @id @default(autoincrement())
  note      String
  createdAt DateTime @default(now())
}

enum Role {
  CITIZEN
  HOSPITAL_STAFF
  ADMIN
}

enum HospitalType {
  GOVT
  PRIVATE
}

enum ResourceKind {
  COUNTABLE
  STATUS
}

enum RequirementLevel {
  CRITICAL
  PREFERRED
}

enum ReservationStatus {
  HELD
  ARRIVED
  CANCELLED
  EXPIRED
  REJECTED
  COMPLETED
}

enum ReviewStatus {
  DRAFT
  SOURCE_CHECKED
  MEDICALLY_REVIEWED
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  O_POS
  O_NEG
  AB_POS
  AB_NEG
}

model User {
  id           String    @id @default(cuid())
  phone        String    @unique
  name         String
  passwordHash String
  role         Role      @default(CITIZEN)
  hospitalId   String?
  hospital     Hospital? @relation(fields: [hospitalId], references: [id])
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([hospitalId])
}

model Session {
  id         String   @id // sha256 hex of the session token
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Hospital {
  id              String             @id @default(cuid())
  slug            String             @unique
  nameBn          String
  nameEn          String
  type            HospitalType
  freeService     Boolean
  liveDataEnabled Boolean            @default(true)
  phone           String
  division        String
  district        String
  area            String
  address         String
  lat             Float
  lng             Float
  users           User[]
  resources       HospitalResource[]
  reservations    Reservation[]
  soldOutEvents   SoldOutEvent[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([type])
  @@index([district])
  @@index([liveDataEnabled])
  @@index([freeService])
}

model ResourceType {
  id                String                 @id @default(cuid())
  code              String                 @unique
  kind              ResourceKind
  consumable        Boolean
  nameBn            String
  nameEn            String
  bloodGroup        BloodGroup?            @unique
  sortOrder         Int
  hospitalResources HospitalResource[]
  requirements      ConditionRequirement[]
  reservations      Reservation[]
  soldOutEvents     SoldOutEvent[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model HospitalResource {
  id             String        @id @default(cuid())
  hospitalId     String
  hospital       Hospital      @relation(fields: [hospitalId], references: [id])
  resourceTypeId String
  resourceType   ResourceType  @relation(fields: [resourceTypeId], references: [id])
  total          Int           @default(0)
  available      Int           @default(0)
  isAvailable    Boolean       @default(false)
  version        Int           @default(1)
  updatedAt      DateTime // set explicitly (not @updatedAt) so seed can create stale rows
  updatedById    String?
  reservations   Reservation[]
  createdAt      DateTime      @default(now())

  @@unique([hospitalId, resourceTypeId])
  @@index([resourceTypeId])
  @@index([updatedAt])
}

model Condition {
  id           String                 @id @default(cuid())
  code         String                 @unique
  nameBn       String
  nameEn       String
  sortOrder    Int
  requirements ConditionRequirement[]
  firstAid     FirstAidGuide?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model ConditionRequirement {
  id             String           @id @default(cuid())
  conditionId    String
  condition      Condition        @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  resourceTypeId String?
  resourceType   ResourceType?    @relation(fields: [resourceTypeId], references: [id])
  isBlood        Boolean          @default(false)
  level          RequirementLevel
  minQuantity    Int              @default(1)
  sortOrder      Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([conditionId])
}

model BloodCompatibility {
  donor     BloodGroup
  recipient BloodGroup
  createdAt DateTime   @default(now())

  @@id([donor, recipient])
}

model FirstAidGuide {
  id           String       @id @default(cuid())
  conditionId  String       @unique
  condition    Condition    @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  dosBn        String[]
  dosEn        String[]
  dontsBn      String[]
  dontsEn      String[]
  sourceName   String
  sourceUrl    String
  reviewStatus ReviewStatus
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Reservation {
  id                 String             @id @default(cuid())
  userId             String
  hospitalId         String
  hospital           Hospital           @relation(fields: [hospitalId], references: [id])
  resourceTypeId     String
  resourceType       ResourceType       @relation(fields: [resourceTypeId], references: [id])
  hospitalResourceId String
  hospitalResource   HospitalResource   @relation(fields: [hospitalResourceId], references: [id])
  conditionId        String?
  quantity           Int                @default(1)
  status             ReservationStatus  @default(HELD)
  expiresAt          DateTime
  idempotencyKey     String             @unique
  version            Int                @default(1)
  arrivedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  rejectedReason     String?
  events             ReservationEvent[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([userId, status])
  @@index([hospitalId, status])
  @@index([status, expiresAt])
}

model ReservationEvent {
  id            String             @id @default(cuid())
  reservationId String
  reservation   Reservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  fromStatus    ReservationStatus?
  toStatus      ReservationStatus
  actorUserId   String?
  note          String?
  createdAt     DateTime           @default(now())

  @@index([reservationId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([actorUserId])
}

model SoldOutEvent {
  id             String       @id @default(cuid())
  hospitalId     String
  hospital       Hospital     @relation(fields: [hospitalId], references: [id])
  resourceTypeId String
  resourceType   ResourceType @relation(fields: [resourceTypeId], references: [id])
  conditionId    String?
  userId         String?
  createdAt      DateTime     @default(now())

  @@index([createdAt])
  @@index([resourceTypeId, createdAt])
}

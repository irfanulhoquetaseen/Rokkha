# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string used by Prisma (app runtime, migrations, seed).
# Local dev: the Railway Postgres PUBLIC url (DATABASE_PUBLIC_URL in Railway).
# On Railway: reference the INTERNAL url, i.e. ${{Postgres.DATABASE_URL}}.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Integration tests ONLY. Must point at a database whose name ends in "_test"
# (tests refuse to run otherwise, so production can never be truncated).
# Local: same Railway Postgres public host, database "jibonsetu_test".
DATABASE_URL_TEST="postgresql://USER:PASSWORD@HOST:PORT/jibonsetu_test"

# Port the custom server (Next.js + Socket.io) listens on. Railway injects this automatically.
PORT=3000

# Optional bind address. Defaults: localhost in dev, 0.0.0.0 in production.
# HOST=0.0.0.0

# "production" on Railway (set by `npm start`); leave unset for local dev.
# NODE_ENV=production

# Optional: run Playwright E2E against a deployed URL instead of the local dev server.
# BASE_URL=https://your-app.up.railway.app

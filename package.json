{
    "name": "jibonsetu",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "tsx watch --clear-screen=false server.ts",
        "build": "prisma generate && next build && npm run build:server",
        "build:server": "esbuild server.ts --bundle --platform=node --target=node24 --format=esm --packages=external --tsconfig=tsconfig.json --outfile=dist/server.mjs",
        "start": "cross-env NODE_ENV=production node dist/server.mjs",
        "typecheck": "next typegen && tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:seed": "prisma db seed",
        "postinstall": "prisma generate",
        "test:unit": "vitest run --project unit",
        "test:integration": "vitest run --project integration"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "bcryptjs": "^3.0.3",
        "cross-env": "^10.1.0",
        "dotenv": "^18.0.10",
        "next": "^16.4.6",
        "prisma": "^7.10.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "socket.io": "^4.8.4",
        "socket.io-client": "^4.8.4",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@playwright/test": "^1.65.1",
        "@tailwindcss/turbopack": "4.3.3",
        "@types/node": "^24.19.2",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "esbuild": "^0.28.2",
        "eslint": "^9",
        "eslint-config-next": "16.4.6",
        "tailwindcss": "4.3.3",
        "tsx": "^4.23.15",
        "typescript": "^5",
        "vitest": "^5.1.1"
    },
    "engines": {
        "node": ">=24"
    }
}
